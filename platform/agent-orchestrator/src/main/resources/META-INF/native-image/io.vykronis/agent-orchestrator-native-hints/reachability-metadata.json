{
  "comment": "Vykronis app-level native hints (non-AOT-generated coords)",
  "reflection": [
    {
      "type": "org.hibernate.validator.internal.util.logging.Log_$logger",
      "allDeclaredConstructors": true,
      "allDeclaredMethods": true
    },
    {
      "type": "org.hibernate.validator.internal.util.logging.Messages_$bundle",
      "allDeclaredConstructors": true,
      "allDeclaredFields": true,
      "allDeclaredMethods": true
    },
    {
      "type": "com.google.protobuf.ExtensionRegistry",
      "allDeclaredConstructors": true,
      "allDeclaredMethods": true
    },
    {
      "type": "com.google.protobuf.ExtensionRegistryLite",
      "allDeclaredConstructors": true,
      "allDeclaredMethods": true
    }
  ],
  "resources": [
    {
      "glob": "/"
    },
    {
      "glob": "schema/"
    },
    {
      "glob": "schema/hypothesis.schema.json"
    }
  ]
}