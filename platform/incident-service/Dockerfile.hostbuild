# Runtime-only stage: copy the jar pre-built on the host (build-staging/
# incident-app.jar). Mirrors platform/remediation-service/Dockerfile.hostbuild
# so containers are cheap to rebuild under limited memory.
FROM vykronis/runtime:local
WORKDIR /app
COPY build-staging/incident-app.jar /app/app.jar
EXPOSE 8084
ENTRYPOINT ["java", "-jar", "/app/app.jar"]